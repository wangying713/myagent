{
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "[go]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "goImplementationLens.showReferences": false,
  "go.alternateTools": {
    "go": "${workspaceFolder}/.tools/go1.27.2/bin/go",
    "gopls": "${workspaceFolder}/.tools/gopls/bin/gopls"
  },
  "go.toolsEnvVars": {
    "GOROOT": "${workspaceFolder}/.tools/go1.27.2",
    "GOTOOLCHAIN": "local",
    "PATH": "${workspaceFolder}/.tools/go1.27.2/bin:${env:PATH}"
  }
}
