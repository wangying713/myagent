# 显式使用 -env-file .env 加载；环境变量优先，不自动读取 old 配置。
HTTP_ADDRESS=127.0.0.1:8080
HTTP_RUN_TIMEOUT=120s

DEEPSEEK_API_KEY=put-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60s

TELEMETRY_ENABLED=true
OTEL_SERVICE_NAME=agent
# 业务和模型 span 使用的追踪器名称
TELEMETRY_TRACER_NAME=go-demos
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:5080/api/default/v1/traces
OTEL_EXPORTER_OTLP_TRACES_HEADERS="Authorization=Basic%20REPLACE_ME,stream-name=default"
TELEMETRY_CAPTURE_CONTENT=true
TELEMETRY_CONTENT_MAX_CHARS=32768

AGENT_MAX_MODEL_CALLS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_TOKEN_BUDGET=8000
