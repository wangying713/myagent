# 复制成 .env 后填写；已有 .env 时不要覆盖。
DEEPSEEK_API_KEY=put-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60

OTEL_SERVICE_NAME=agent-learning
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
# 从 OpenObserve 的接入页面复制 Basic 凭据；不要提交真实值。
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic replace-with-your-base64-credentials"
TELEMETRY_ENABLED=true
# 学习模式记录请求/响应；使用真实敏感材料时可只记录元信息。
TELEMETRY_CAPTURE_CONTENT=true
TELEMETRY_CONTENT_MAX_CHARS=32768
