{
  "reportMissingTypeArgument": "error",
  "typeCheckingMode": "standard",
  "venvPath": "my-agent",
  "venv": ".venv",
  "extraPaths": [
    "my-agent/src",
    "openai-agents-python/src",
    "openai-agents-python"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
